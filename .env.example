# CampusConnect Environment Configuration Example
# Copy this file to .env and replace placeholder values before running in production.

# Application Core
APP_NAME=CampusConnect
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security Secrets (Must be changed in production! Generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Database Connection (PostgreSQL with psycopg driver)
DATABASE_URL=postgresql+psycopg://campus_user:campus_password@localhost:5432/campusconnect
# Optional fallback for local dev without PostgreSQL Docker running:
# DATABASE_URL=sqlite+aiosqlite:///./campusconnect.db

# Server-Side Sessions & Security Cookies
SESSION_COOKIE_NAME=campus_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true
SESSION_MAX_AGE_SECONDS=86400

# CSRF Protection
CSRF_COOKIE_NAME=campus_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Storage & File Uploads
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_FILE_EXTENSIONS=["pdf","jpg","jpeg","png"]
MAX_ATTACHMENTS_PER_ITEM=5

# Rate Limiting (slowapi / in-memory or redis)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_RESET=3/minute

# Email Service (Password Reset)
DEV_EMAIL_CONSOLE=true
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@campusconnect.edu
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@campusconnect.edu
SMTP_USE_TLS=true
